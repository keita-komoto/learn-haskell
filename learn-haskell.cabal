cabal-version: 3.14
name: learn-haskell
version: 0.1.0.0
author: KOMOTO Keita
build-type: Simple

library
  exposed-modules:
    Chapter01
    Chapter02
    Chapter03
    Chapter04
    Chapter05
    Chapter06
    Chapter06.Geometry
    Chapter07

  hs-source-dirs: app
  build-depends:
    base,
    containers ^>=0.7,

test-suite test
  type: exitcode-stdio-1.0
  main-is: Driver.hs
  hs-source-dirs: test
  build-depends:
    base,
    hedgehog,
    learn-haskell,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    tasty-rerun,

  other-modules:
    Chapter01Test
    Chapter05Test
    Chapter06Test
    Rerun

  build-tool-depends:
    tasty-discover:tasty-discover

  ghc-options: -Wno-missing-signatures
